# =============================================================================
#  TRIỂN KHAI MIỄN PHÍ 24/7 — điền tệp này (deploy/cloud.env, KHÔNG đưa lên GitHub) rồi chạy: npm run deploy:cloud
#  Tất cả dịch vụ dưới đây có gói miễn phí và cho đăng nhập bằng tài khoản GitHub (steveprovip) — không cần thẻ.
#  Thứ tự làm (khoảng 15 phút, chỉ một lần):
#   1) CSDL  — https://supabase.com → New project (region Singapore) → Connect → "Session pooler" → copy URI
#              (hoặc https://neon.tech → New project → Connection string, bỏ "-pooler")
#   2) API   — https://render.com → New → Blueprint → chọn repo thucTap_HeThongDatLichSPA (đọc render.yaml)
#              → khi Render hỏi biến, có thể để trống; script tự điền nếu có RENDER_API_KEY bên dưới
#              → copy địa chỉ dịch vụ (https://salon-spa-api-xxxx.onrender.com) vào API_URL
#   3) Email — https://www.brevo.com → SMTP & API → API Keys → Generate; Senders → xác minh email người gửi
#   4) Cloudflare — https://dash.cloudflare.com (đăng ký miễn phí); script tự mở trình duyệt để bạn đăng nhập lần đầu
# =============================================================================

# 1. Chuỗi kết nối PostgreSQL (Supabase Session pooler cổng 5432, hoặc Neon kết nối trực tiếp)
DATABASE_URL=

# 2. Địa chỉ dịch vụ API trên Render, KHÔNG có /api ở cuối
API_URL=

# 3. Tên dự án Cloudflare Pages → link cố định https://<tên>.pages.dev (chữ thường, số, gạch ngang)
PAGES_PROJECT=huongsen-salon

# 4. (tuỳ chọn) Để script tự điền biến môi trường cho Render: Render → Account Settings → API Keys;
#    RENDER_SERVICE_ID lấy trong URL trang dịch vụ (srv-xxxxxxxx)
RENDER_API_KEY=
RENDER_SERVICE_ID=

# 5. Email qua Brevo (miễn phí 300 thư/ngày) — Render Free chặn cổng SMTP nên dùng API
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Salon & Spa Hương Sen

# 6. Tài khoản quản trị đầu tiên (CSDL trống thì tạo; đăng nhập lần đầu hệ thống bắt đổi mật khẩu)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 7. Thông tin tiệm hiện trên trang khách / email
SALON_NAME=Salon & Spa Hương Sen
SALON_HOTLINE=
SALON_ADDRESS=
