# Copy to production.env, keep outside Git, and supply absolute paths to compose.
SALON_PROD_DB_USER=salon
SALON_PROD_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
SALON_PROD_DB_NAME=salon_booking
SALON_PROD_IMAGE=salon-spa:release-candidate
SALON_PROD_REVISION=unreleased
SALON_PROD_PORT=3000
FRONTEND_URL=https://salon.example.com
CORS_ORIGINS=https://salon.example.com
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
TRUST_PROXY=loopback
SWAGGER_ENABLED=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=booking@example.com
SALON_NAME=Salon Spa
SALON_ADDRESS=REPLACE_WITH_SHOP_ADDRESS
SALON_HOTLINE=REPLACE_WITH_SHOP_PHONE
