FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --prefix backend --no-audit --no-fund
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm ci --prefix frontend --no-audit --no-fund
COPY backend/src ./backend/src
COPY backend/database ./backend/database
COPY backend/nest-cli.json backend/tsconfig*.json ./backend/
COPY frontend ./frontend
ARG COMMIT_SHA=unreleased
ENV COMMIT_SHA=$COMMIT_SHA VITE_DEMO_MODE=false VITE_API_BASE_URL=/api
RUN npm run build --prefix backend && npm run build --prefix frontend
RUN npm prune --prefix backend --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim AS runtime
# PostgreSQL 15 is the original coursework/runtime target. Client must not be older than the server.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client-15 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
ENV NODE_ENV=production PORT=3000 SERVE_FRONTEND=true BACKUP_DIR=/app/backups
COPY --from=build --chown=node:node /app/backend/node_modules ./node_modules
COPY --from=build --chown=node:node /app/backend/dist ./dist
COPY --from=build --chown=node:node /app/backend/database ./database
COPY --from=build --chown=node:node /app/frontend/dist /app/frontend/dist
RUN mkdir -p /app/backups /app/backend/uploads && chown -R node:node /app/backups /app/backend/uploads
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "node dist/database/migrate.js run --backup=required && node dist/database/run-bootstrap.js && node dist/database/security-check.js --lock && exec node dist/main.js"]
