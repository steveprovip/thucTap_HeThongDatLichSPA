{
  "name": "salon-spa-booking",
  "version": "1.6.0",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/steveprovip/thucTap_HeThongDatLichSPA.git" },
  "description": "Hệ thống đặt lịch Salon - Spa: quản lý lịch hẹn, ca làm, thanh toán và báo cáo",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "db:up": "docker compose --project-directory . -f deploy/docker/docker-compose.yml up -d postgres maildev pgadmin",
    "db:down": "docker compose --project-directory . -f deploy/docker/docker-compose.yml down",
    "db:reset": "docker compose --project-directory . -f deploy/docker/docker-compose.yml down -v && docker compose --project-directory . -f deploy/docker/docker-compose.yml up -d postgres maildev pgadmin",
    "db:migrate": "npm run migration:run --prefix backend",
    "db:status": "npm run migration:status --prefix backend",
    "db:backup": "npm run backup --prefix backend",
    "db:schema": "npm run migration:run --prefix backend",
    "db:seed": "npm run seed --prefix backend",
    "db:seed:scale": "npm run seed:scale --prefix backend --",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "prestart:all": "node scripts/launcher.mjs prepare",
    "start:all": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "start:launch": "node scripts/launcher.mjs run",
    "launcher": "node scripts/hoyo/launcher-ui.mjs",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "test": "npm run test --prefix backend",
    "test:e2e": "npm run test:e2e --prefix backend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "start:server": "node scripts/launcher.mjs serve",
    "stop:server": "node scripts/launcher.mjs stop",
    "update": "node scripts/update.mjs",
    "doctor": "node scripts/launcher.mjs doctor",
    "backup": "node scripts/backup.mjs",
    "migration:generate": "npm run migration:generate --prefix backend --",
    "security:check": "npm run security:check --prefix backend",
    "test:ai:e2e": "e2e run",
    "test:ai:e2e:headed": "e2e run --headed",
    "test:ai:e2e:deterministic": "e2e run tests/01_public_booking_flow.e2e.ts tests/02_auth_and_roles.e2e.ts",
    "test:ai:e2e:explore": "e2e explore \"Kham pha toan bo he thong Salon Spa va tim loi\"",
    "docs:report": "python docs/tools/build_report_docx.py && python docs/tools/build_slides_pptx.py",
    "test:scripts": "node --test scripts/lib/test/*.test.mjs",
    "test:frontend": "npm run test --prefix frontend",
    "check:scripts": "node --check scripts/launcher.mjs && node --check scripts/hoyo/launcher-ui.mjs && node --check scripts/update.mjs && node --check scripts/backup.mjs"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.72",
    "@ai-sdk/google": "^4.0.88",
    "@ai-sdk/openai": "^4.0.84",
    "@ai-sdk/openai-compatible": "^3.0.63",
    "@e2e-dev/web": "^0.12.0",
    "ai": "^7.0.128",
    "concurrently": "^9.1.0",
    "dotenv": "^18.0.5",
    "e2e": "^0.17.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  }
}
