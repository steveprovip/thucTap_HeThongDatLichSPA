SALON_ADDRESS=128 Nguyễn Văn Cừ, Quận 5, TP. Hồ Chí Minh
SALON_HOTLINE=028 3838 6868

# ===== Cơ sở dữ liệu =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=salon
DB_PASSWORD=salon123
DB_NAME=salon_booking
DB_LOGGING=false

# ===== JWT =====
JWT_ACCESS_SECRET=doi_chuoi_nay_trong_moi_truong_that_access
JWT_REFRESH_SECRET=doi_chuoi_nay_trong_moi_truong_that_refresh
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# ===== Bảo mật =====
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_ROUNDS=10
BOOKING_IP_LIMIT_PER_HOUR=5
LOOKUP_IP_LIMIT_PER_HOUR=10
LOOKUP_BLOCK_MINUTES=30
RESET_EMAIL_LIMIT_PER_HOUR=3

# ===== Quy tắc nghiệp vụ =====
MIN_LEAD_TIME_MINUTES=60
CANCEL_CUTOFF_MINUTES=120
MAX_SERVICES_PER_BOOKING=5
MAX_ACTIVE_BOOKINGS_PER_PHONE=3
SLOT_STEP_MINUTES=15
NO_SHOW_AFTER_MINUTES=30
OVERRUN_WARNING_MINUTES=20
REVIEW_TOKEN_DAYS=7
MIN_REVIEWS_TO_SHOW_AVG=5

# ===== SMTP (Maildev) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Salon & Spa Hương Sen
MAIL_FROM_ADDRESS=no-reply@salon.vn
MAIL_WORKER_ENABLED=true

# ===== Tệp tải lên =====
UPLOAD_DIR=uploads
MAX_AVATAR_SIZE_MB=2
