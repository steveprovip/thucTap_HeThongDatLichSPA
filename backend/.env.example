SALON_MAP_URL=
SALON_SLOGAN=Chăm sóc tóc, da và tinh thần trong không gian tinh tế
# Tài khoản nhận chuyển khoản VietQR (đọc lúc chạy, không cần build lại giao diện). Sửa dễ nhất: Launcher > Thiết lập cửa hàng
#   BANK_BIN: mã ngân hàng NAPAS 6 số (970436 Vietcombank, 970415 VietinBank, 970418 BIDV, 970407 Techcombank, 970422 MB…)
BANK_BIN=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=

# ===== Cơ sở dữ liệu =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=salon
DB_PASSWORD=salon123
DB_NAME=salon_booking
DB_LOGGING=false

# ===== JWT =====
JWT_ACCESS_SECRET=doi_chuoi_nay_trong_moi_truong_that_access
JWT_REFRESH_SECRET=doi_chuoi_nay_trong_moi_truong_that_refresh
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# ===== Bảo mật =====
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_ROUNDS=10
BOOKING_IP_LIMIT_PER_HOUR=5
LOOKUP_IP_LIMIT_PER_HOUR=10
LOOKUP_BLOCK_MINUTES=30
RESET_EMAIL_LIMIT_PER_HOUR=3

# ===== Quy tắc nghiệp vụ =====
MIN_LEAD_TIME_MINUTES=60
CANCEL_CUTOFF_MINUTES=120
MAX_SERVICES_PER_BOOKING=5
MAX_ACTIVE_BOOKINGS_PER_PHONE=3
SLOT_STEP_MINUTES=15
# Giữ chỗ khung giờ khi khách đang điền form đặt lịch (5–15 phút)
SLOT_HOLD_MINUTES=10
SLOT_HOLD_IP_LIMIT_PER_HOUR=30
NO_SHOW_AFTER_MINUTES=30
OVERRUN_WARNING_MINUTES=20
REVIEW_TOKEN_DAYS=7
MIN_REVIEWS_TO_SHOW_AVG=5

# ===== SMTP (Maildev) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Salon & Spa Hương Sen
MAIL_FROM_ADDRESS=no-reply@salon.vn
MAIL_WORKER_ENABLED=true

# ===== Tệp tải lên =====
UPLOAD_DIR=uploads
MAX_AVATAR_SIZE_MB=2


# =============================================================================
#  TRIỂN KHAI MÁY CHỦ THẬT / ĐÁM MÂY  (máy phát triển để nguyên, không cần đụng tới phần này)
#  Hướng dẫn đầy đủ: docs/TRIEN-KHAI.md
# =============================================================================

# ----- Kết nối CSDL kiểu đám mây (Neon / Supabase / Render). Có DATABASE_URL thì DB_HOST... ở trên bị bỏ qua -----
# Dùng chuỗi KẾT NỐI TRỰC TIẾP (không phải -pooler / cổng 6543) để chạy migration.
#DATABASE_URL=postgresql://tai_khoan:mat_khau@may-chu:5432/ten_csdl?sslmode=require
# false (mặc định) | true = mã hoá + kiểm tra chứng chỉ | require = mã hoá, không kiểm tra chứng chỉ
#DB_SSL=false
#DB_POOL_MAX=20
# Neon / Supabase pooler từ chối tuỳ chọn múi giờ lúc kết nối -> đặt false (dữ liệu không bị ảnh hưởng)
#DB_STARTUP_TIMEZONE=true

# ----- Chạy bản production (start_server.bat đặt sẵn NODE_ENV=production, SERVE_FRONTEND=true) -----
# true: NestJS phục vụ luôn giao diện đã build -> chỉ cần MỘT địa chỉ / một đường hầm Cloudflare cho cả web lẫn API
#SERVE_FRONTEND=false
#FRONTEND_DIST=
# Giao diện đặt ở tên miền khác (Cloudflare Pages...): liệt kê, cách nhau bằng dấu phẩy, không có dấu / ở cuối
#CORS_ORIGINS=https://ten-du-an.pages.dev
# Địa chỉ CÔNG KHAI của hệ thống (nằm trong link email xác nhận / đặt lại mật khẩu gửi cho khách)
#FRONTEND_URL=https://ten-du-an.pages.dev
# Số lớp proxy tin cậy trước API: cloudflared chạy cùng máy = loopback (mặc định), Render = 1
#TRUST_PROXY=loopback
#SWAGGER_ENABLED=false

# ----- Tài khoản quản trị đầu tiên cho CSDL TRỐNG (npm run bootstrap, chạy tự động bởi start_server) -----
# Chỉ dùng khi bảng users còn trống; đã có người dùng thì bỏ qua. Mật khẩu: >= 8 ký tự, có chữ và số, không dấu.
# Lưu ý: trong tệp .env ký tự # mở đầu phần ghi chú -> mật khẩu có # phải đặt trong dấu nháy kép.
#BOOTSTRAP_ADMIN_EMAIL=
#BOOTSTRAP_ADMIN_PASSWORD=

# ----- Sao lưu trước khi đổi cấu trúc CSDL -----
# auto (mặc định): chỉ sao lưu khi CSDL đã có dữ liệu thật VÀ có migration chờ chạy
# required: không sao lưu được thì DỪNG, không migration (update_project dùng chế độ này) | off: bỏ qua
#MIGRATION_BACKUP=auto
#UPDATE_BACKUP=required
# Sao lưu tự động mỗi ngày 02:00 (giờ VN) + bù khi máy bật lại nếu bản gần nhất cũ hơn 26 giờ (chỉ bản build production). off = tắt
#BACKUP_DAILY=on
#BACKUP_DIR=

# ----- Dữ liệu mẫu (chỉ máy phát triển) -----
# npm run seed bị chặn khi NODE_ENV=production trừ khi SEED_ALLOW_PRODUCTION=1
#SEED_ALLOW_PRODUCTION=
# never: chỉ cập nhật cấu trúc, không nạp dữ liệu mẫu
#SALON_SEED=

# ----- Kiểm thử e2e: chạy trên CSDL TẠM, không đụng CSDL thật -----
# Tên bắt buộc kết thúc bằng _test; tự tạo trước khi chạy và tự xoá sau khi chạy xong
#TEST_DB_NAME=salon_booking_test
#TEST_DB_KEEP=0
#TEST_DB_ALLOW_REMOTE=0

# ----- Đồng bộ thời gian thực (SSE) -----
# Chu kỳ tín hiệu giữ kết nối, mili giây (mặc định 20000)
#SSE_HEARTBEAT_MS=20000
