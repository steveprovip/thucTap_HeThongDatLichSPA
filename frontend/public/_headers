# Cloudflare Pages — header phản hồi cho bản build tĩnh (dist/).
# Không có 404.html → Pages tự trả index.html cho mọi đường dẫn React Router (/dat-lich, /quan-ly/...).

# Tệp build có mã băm trong tên (Vite) và font tự host: không bao giờ đổi nội dung → cache 1 năm
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Mọi trang: chặn đoán kiểu MIME, không gửi đường dẫn đầy đủ sang trang khác, không cho nhúng vào khung trang lạ
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
