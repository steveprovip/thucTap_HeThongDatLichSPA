# false = Full-Stack API Mode (gọi NestJS thật qua proxy /api). Bản demo không cần server: npm run dev:demo
VITE_DEMO_MODE=false
# Cùng một địa chỉ cho web và API (Docker tại máy, hoặc NestJS tự phục vụ giao diện): để /api
# Giao diện và API ở hai địa chỉ khác nhau (Cloudflare Pages + Render): ghi địa chỉ đầy đủ, VD https://salon-api.onrender.com/api
VITE_API_BASE_URL=/api
# Tên / địa chỉ / hotline / ngân hàng: máy chủ trả về LÚC CHẠY (backend/.env, Launcher > Thiết lập cửa hàng) và được ưu tiên;
# các giá trị dưới đây chỉ là dự phòng lúc build (giao diện tách riêng không gọi được API).
VITE_SALON_NAME=Salon & Spa Hương Sen
VITE_SALON_ADDRESS=128 Nguyễn Văn Cừ, Quận 5, TP. Hồ Chí Minh
VITE_SALON_HOTLINE=028 3838 6868

# VietQR dự phòng lúc build (ưu tiên BANK_* trong backend/.env). BIN 6 số theo NAPAS, VD 970436 = Vietcombank.
VITE_BANK_BIN=
VITE_BANK_ACCOUNT_NO=
VITE_BANK_ACCOUNT_NAME=
