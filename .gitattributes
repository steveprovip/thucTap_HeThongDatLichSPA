# Chuẩn hoá xuống dòng để launcher chạy được trên MỌI máy, bất kể cấu hình core.autocrlf:
#  - .sh phải là LF, nếu không bash báo "$'\r': command not found"
#  - .bat/.cmd phải là CRLF, nếu không cmd.exe nhảy nhãn (goto/call :label) sai
* text=auto
*.sh   text eol=lf
*.mjs  text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
# Windows Script Host chỉ đọc đúng tiếng Việt khi tệp là UTF-16 LE có BOM; kho mã vẫn lưu UTF-8 (diff đọc được)
*.vbs  text eol=crlf working-tree-encoding=UTF-16LE-BOM
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.docx binary
*.pdf  binary
